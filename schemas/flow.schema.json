{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jylee9937/lofo-dev-harness/main/schemas/flow.schema.json",
  "title": "lofo-dev-harness wireflow",
  "description": "Screens, transitions and UX review marks for one user goal. Lives at design/flows/<id>.flow.json. Checked and rendered by scripts/flow.py; the design tool (Figma, Pencil or any other) mirrors it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "goal", "language", "stages", "start", "screens"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/id", "description": "Stable flow ID. Copied change requests carry it." },
    "title": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1, "description": "The user goal this flow serves, in one sentence." },
    "language": { "enum": ["ko", "en"] },
    "device": { "enum": ["mobile", "tablet", "desktop"], "default": "mobile" },
    "source": { "type": "string", "description": "Where the requirements came from (doc path, issue, meeting note)." },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": { "enum": ["none", "figma", "pencil", "other"] },
        "ref": { "type": "string", "description": "File, page or frame reference in the design tool. No personal paths." }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered groups of screens, usually the steps of the task.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1 }
        }
      }
    },
    "start": { "$ref": "#/$defs/id", "description": "Screen where the main journey starts." },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "description": "Other screens a user can land on directly (deep links, notifications)."
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/screen" }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario" }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "requests": {
      "type": "array",
      "items": { "$ref": "#/$defs/request" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "stage", "origin", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "number": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$", "description": "Display number such as 02.01. Generated from stage and order when omitted." },
        "title": { "type": "string", "minLength": 1 },
        "stage": { "$ref": "#/$defs/id" },
        "state": {
          "enum": ["default", "empty", "loading", "error", "success", "modal"],
          "default": "default",
          "description": "Which variant of the screen this is. Empty, loading and error variants sit next to their default screen."
        },
        "origin": {
          "enum": ["source", "inferred"],
          "description": "source: the requirements ask for this screen. inferred: AI added it; keep it visibly marked until the user accepts it."
        },
        "rationale": { "type": "string", "description": "Planning rationale (기획 근거): why this screen exists, from the source." },
        "conditions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "UX conditions and branches that apply on this screen."
        },
        "wireframe": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" },
          "description": "Low-fidelity layout, top to bottom."
        },
        "image": {
          "type": "string",
          "description": "Design mockup image exported from any design tool, relative to the flow file."
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" },
          "description": "Every way to leave this screen. An empty list is allowed only on end screens."
        },
        "end": { "type": "boolean", "default": false, "description": "The user's task may intentionally end here." }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["header", "title", "text", "search", "input", "button", "list", "card", "image", "tabs", "notice", "toggle", "divider"] },
        "label": { "type": "string" },
        "items": { "type": "array", "items": { "type": "string" } },
        "action": { "$ref": "#/$defs/id", "description": "Action on this screen that this block triggers; arrows start here." }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "description": "What the user does, e.g. 'Tap Book'." },
        "to": {
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }],
          "description": "Target screen ID, or null for a destination that is not designed yet."
        },
        "kind": {
          "enum": ["primary", "secondary", "back", "close", "tab", "system"],
          "default": "primary",
          "description": "system: happens without user input (server response, timeout)."
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["main", "recovery", "edge"], "default": "main" },
        "start": { "$ref": "#/$defs/id" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["screen", "action"],
            "properties": {
              "screen": { "$ref": "#/$defs/id" },
              "action": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "screen": { "$ref": "#/$defs/id" },
        "question": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["open", "decided", "deferred"] },
        "answer": { "type": "string" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "screen", "severity", "category", "title", "origin", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "screen": { "$ref": "#/$defs/id" },
        "action": { "$ref": "#/$defs/id" },
        "severity": {
          "enum": ["S1", "S2", "S3", "S4"],
          "description": "S1 blocks the task or loses data. S2 major friction or missing recovery. S3 confusing or inconsistent. S4 polish."
        },
        "category": { "enum": ["flow", "navigation", "feedback", "error-recovery", "empty-state", "consistency", "copy", "accessibility", "other"] },
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" },
        "suggestion": { "type": "string" },
        "origin": { "enum": ["ai-review", "codex", "user", "qa"] },
        "status": { "enum": ["open", "accepted", "fixed", "wontfix"] }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "screen", "text", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "screen": { "$ref": "#/$defs/id" },
        "action": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1, "description": "Change request (수정 요청) in the reviewer's words." },
        "status": { "enum": ["open", "done", "rejected"] },
        "resolution": { "type": "string" }
      }
    }
  }
}
