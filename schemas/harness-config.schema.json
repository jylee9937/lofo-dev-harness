{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jylee9937/lofo-dev-harness/main/schemas/harness-config.schema.json",
  "title": "lofo-dev-harness project config",
  "description": "Per-project settings read by the lofo-dev-harness skills, hooks and scripts. Lives at .harness/config.json in the project root and is generated by /lofo-dev-harness:init. Commit it. Machine-specific values (local paths, vault locations) never go here; they belong in .harness/config.local.json, which is gitignored.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "language", "mode", "stack", "models", "gates"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1,
      "description": "Config format version."
    },
    "language": {
      "enum": ["ko", "en"],
      "description": "Language for generated docs and agent reports."
    },
    "mode": {
      "enum": ["collab", "autonomous"],
      "description": "collab: commits, pushes and PRs only when the user asks. autonomous: unattended work in a time window, a decision queue for the owner, and merges only after the Codex security gate passes."
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "db", "hosting", "packageManager"],
      "properties": {
        "framework": {
          "type": "string",
          "minLength": 1,
          "examples": ["nextjs", "other"],
          "description": "Framework preset id, or 'other' when no preset applies."
        },
        "db": {
          "enum": ["supabase", "firebase", "postgres", "none", "other"]
        },
        "hosting": {
          "enum": ["vercel", "gcp", "aws", "other"]
        },
        "packageManager": {
          "enum": ["pnpm", "npm", "yarn", "bun"]
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claudeFallback"],
      "properties": {
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "description": "Passed explicitly on every Codex call. Without it Codex silently falls back to the global default model."
            },
            "effort": {
              "enum": ["minimal", "low", "medium", "high", "xhigh"],
              "description": "Codex reasoning effort."
            }
          },
          "if": {
            "properties": { "enabled": { "const": true } }
          },
          "then": {
            "required": ["model", "effort"]
          }
        },
        "claudeFallback": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Claude models used in order when Codex is disabled, unavailable or rate-limited. Aliases such as opus, sonnet and haiku keep this file stable across model releases."
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "description": "Commands that must all pass before work counts as done, run in order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "run"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:-]*$"
          },
          "run": {
            "type": "string",
            "minLength": 1
          },
          "offline": {
            "type": "boolean",
            "default": true,
            "description": "Whether the command works without network access, for example inside a Codex sandbox."
          }
        }
      }
    },
    "e2e": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run"],
      "description": "End-to-end test command. Passing it is part of the definition of done.",
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "enum": ["playwright", "other"]
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "default": 3100,
          "description": "Dedicated dev-server port for QA, so QA never tests another worktree's server by mistake."
        },
        "viewports": {
          "type": "array",
          "items": { "type": "integer", "minimum": 240 },
          "default": [390, 768, 1440],
          "description": "Viewport widths for visual review."
        }
      }
    },
    "codexRouting": {
      "type": "object",
      "additionalProperties": false,
      "description": "Regular expressions the routing reminder hook matches against file paths relative to the project root, to decide when to suggest delegating an edit to Codex.",
      "properties": {
        "code": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths counted as source code."
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths never counted as source code (docs, generated files, tests)."
        },
        "backend": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Backend-sensitive paths such as auth, data access and migrations. Edits here get a stronger reminder and point to the security gate."
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "devHarness": {
          "type": "string",
          "default": "docs/dev-harness.md"
        },
        "qaHarness": {
          "type": "string",
          "default": "docs/qa-harness.md"
        },
        "flows": {
          "type": "string",
          "default": "design/flows",
          "description": "Folder for wireflow files (<id>.flow.json) used by /lofo-dev-harness:wireflow."
        },
        "handoff": {
          "type": "string",
          "default": ".harness/handoff.md",
          "description": "Start-here handoff file for the next session."
        },
        "handoffMaxKb": {
          "type": "integer",
          "minimum": 1,
          "default": 40,
          "description": "Size limit for the handoff file. Older entries move to an archive so a new session can read the whole file."
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": {
          "enum": ["none", "obsidian", "notion", "other"],
          "default": "none",
          "description": "Where context and decision history is kept outside git."
        },
        "design": {
          "enum": ["none", "figma", "pencil", "other"],
          "default": "none",
          "description": "Design source of truth."
        },
        "gstack": {
          "type": "boolean",
          "default": false,
          "description": "Use gstack review skills (installed separately) as review gates."
        },
        "tasks": {
          "enum": ["none", "ticktick", "github-issues", "other"],
          "default": "none"
        }
      }
    },
    "autonomous": {
      "type": "object",
      "additionalProperties": false,
      "description": "Settings for autonomous mode. Required when mode is autonomous.",
      "required": ["timezone", "workWindow", "wrapUpAt", "decisionsAt"],
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1,
          "examples": ["Asia/Seoul"]
        },
        "workWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/hhmm" },
            "end": { "$ref": "#/$defs/hhmm" }
          }
        },
        "wrapUpAt": {
          "$ref": "#/$defs/hhmm",
          "description": "When unattended work stops and leaves a clean state."
        },
        "decisionsAt": {
          "$ref": "#/$defs/hhmm",
          "description": "When the owner is asked the queued decisions, one at a time."
        },
        "stopAtWeeklyUsagePct": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 95,
          "description": "Stop starting new work when weekly usage reaches this percentage."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "autonomous" } },
        "required": ["mode"]
      },
      "then": {
        "required": ["autonomous"]
      }
    }
  ],
  "$defs": {
    "hhmm": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    }
  }
}
