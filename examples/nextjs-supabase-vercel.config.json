{
  "$schema": "https://raw.githubusercontent.com/jylee9937/lofo-dev-harness/main/schemas/harness-config.schema.json",
  "version": 1,
  "language": "ko",
  "mode": "collab",
  "stack": {
    "framework": "nextjs",
    "db": "supabase",
    "hosting": "vercel",
    "packageManager": "pnpm"
  },
  "models": {
    "codex": { "enabled": true, "model": "gpt-6.1-sol", "effort": "xhigh" },
    "claudeFallback": ["opus", "sonnet", "haiku"]
  },
  "gates": [
    { "name": "lint", "run": "pnpm lint" },
    { "name": "typecheck", "run": "pnpm typecheck" },
    { "name": "build", "run": "pnpm build" },
    { "name": "no-external-images", "run": "pnpm check:no-external-images" }
  ],
  "e2e": { "run": "pnpm test:e2e", "tool": "playwright" },
  "qa": { "port": 3100, "viewports": [390, 768, 1440] },
  "codexRouting": {
    "code": ["\\.(ts|tsx|js|jsx|mjs|cjs|sql)$"],
    "exclude": ["^docs/", "^\\.harness/", "^\\.claude/", "(^|/)node_modules/", "^\\.next/", "^tests?/", "\\.d\\.ts$"],
    "backend": ["^supabase/", "\\.sql$", "/api/", "actions?\\.ts$", "server-only", "webhook"]
  },
  "docs": {
    "devHarness": "docs/dev-harness.md",
    "qaHarness": "docs/qa-harness.md",
    "handoff": ".harness/handoff.md",
    "handoffMaxKb": 40
  },
  "integrations": { "notes": "obsidian", "design": "figma", "gstack": true, "tasks": "none" }
}
